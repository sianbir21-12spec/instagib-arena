rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /players/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Player progression/coins are written by the trusted game server via
      // Firebase Admin SDK. Clients cannot directly change authoritative state.
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    match /coinAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botProfiles/{botId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /voicePacks/{packId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /playerEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /matches/{matchId}/chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bot == false
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }
  }
}
