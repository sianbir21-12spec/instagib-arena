# Port the Node server listens on.
PORT=8787

# Runtime SQLite storage.
# DATA_DIR=./data
# DATABASE_PATH=./data/instagib.sqlite

# Production WebSocket origin allow-list.
# APP_BASE_URL=https://your-server.example

# Admin accounts (comma/space separated, case-insensitive).
ADMIN_USERNAMES=YourName,CoAdmin

# Read-only metrics API token.
# ADMIN_API_TOKEN=

# ── Firebase Admin / Firestore ────────────────────────────────────────────────
# Server-only settings. NEVER put the service-account private key in a VITE_*
# variable or commit it to Git.
FIREBASE_PROJECT_ID=discord-46350
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@discord-46350.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase Web config (public browser configuration) ────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyDFhS4Lynk-ngViadcyrrJ7WxawqKhl4Q
VITE_FIREBASE_AUTH_DOMAIN=discord-46350.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=discord-46350
