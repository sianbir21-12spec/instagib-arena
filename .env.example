# Port the Node server listens on.
PORT=8787

# Runtime SQLite storage.
# DATA_DIR=./data
# DATABASE_PATH=./data/instagib.sqlite

# Production WebSocket origin allow-list.
# APP_BASE_URL=https://your-server.example

# Admin accounts (comma/space separated, case-insensitive).
ADMIN_USERNAMES=YourName,CoAdmin

# Read-only metrics API token.
# ADMIN_API_TOKEN=

# ── Firebase Admin / Firestore ────────────────────────────────────────────────
# The server uses these only. NEVER put the service-account private key in a
# VITE_* variable or commit it to Git.
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase Web config (safe to expose in the browser) ──────────────────────
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
