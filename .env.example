# Port the Node server listens on. In production it serves the built client
# (dist/), the stats API, and the /ws/instagib game socket all on this port.
PORT=8080

# Firebase Web App configuration. These are Vite client variables and are
# intentionally prefixed VITE_. Firebase web config identifiers are not service
# account secrets; protect Firestore/Auth with Firebase Security Rules.
VITE_FIREBASE_API_KEY=AIzaSyCG0cwStBmAirshkqHIWXztz_1bwZQZrc
VITE_FIREBASE_AUTH_DOMAIN=zelloo-440f3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zelloo-440f3
VITE_FIREBASE_STORAGE_BUCKET=zelloo-440f3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=712583135545
VITE_FIREBASE_APP_ID=1:712583135545:web:a02181400f93510450e8e8
VITE_FIREBASE_MEASUREMENT_ID=G-R6RLQGT4QF

# Where runtime data (the SQLite stats DB) is stored. Defaults to ./data.
# DATA_DIR=./data
# DATABASE_PATH=./data/instagib.sqlite

# Production WebSocket origin allow-list. When set, only browsers loading the
# app from this origin may open the game socket. Leave unset for same-origin /
# local dev (any localhost origin is allowed in dev automatically).
# APP_BASE_URL=https://your-server.example

# Admin accounts (comma- or space-separated usernames, case-insensitive).
# ADMIN_USERNAMES=YourName,CoAdmin

# Read-only metrics API token. When set, scripts/agents can pull the read-only
# /api/admin/metrics/* endpoints with Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
# ADMIN_API_TOKEN=
